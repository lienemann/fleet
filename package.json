{
  "name": "fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal supervisor UI and daemon for parallel Claude Code agents",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:daemon": "tsx watch src/daemon/main.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "start": "tsx src/daemon/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
